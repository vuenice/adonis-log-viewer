# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# Log viewer (adonis-log-viewer) — dev: built UI at /logs/assets by default.
# Set to 1 with `npm run dev:frontend` for Vite HMR on /logs.
#--------------------------------------------------------------------
# LOGS_VITE_DEV=1
# LOGS_VITE_ORIGIN=http://localhost:5173
# LOGS_VITE_BASE=/logs/assets

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000